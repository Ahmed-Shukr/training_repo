% for beamer colors

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colors}

\definecolor{bjtnavy}{HTML}{0F1C2E}
\definecolor{bjtteal}{HTML}{0A7A8F}
\definecolor{bjtaccent}{HTML}{E8A838}

% Color theme base
\usecolortheme{default}

% progress bar and structure
\setbeamercolor{progress bar}{fg=bjtaccent,bg=bjtnavy!25}
\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=bjtteal}
\setbeamercolor{title}{fg=white}
\setbeamercolor{frametitle}{fg=white,bg=bjtnavy}
\setbeamercolor{section title}{fg=bjtnavy}
\setbeamercolor{palette primary}{fg=white,bg=bjtnavy}
\setbeamercolor{block title}{fg=bjtnavy,bg=bjtteal!18}
\setbeamercolor{block body}{fg=black,bg=bjtteal!7}


